{
  "expo": {
    "name": "Arena",
    "slug": "arena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arena.sports"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arena.sports"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakındaki spor salonlarını göstermek için konumunu kullanıyoruz."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yemek fotoğrafı seçmek ve paylaşım yapmak için galerine erişiyoruz.",
          "cameraPermission": "Yemeğinin kalorisini tahmin etmek için fotoğraf çekiyoruz."
        }
      ]
    ],
    "scheme": "arena",
    "experiments": {
      "typedRoutes": true
    }
  }
}
